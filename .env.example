# ==============================================================================
# ZERO-COST ($0) DUAL-ROUTE VIRTUAL FAX GATEWAY CONFIGURATION
# ==============================================================================

# --- Sender Information ---
# Used for Fax headers (Route A) and Web Gateway submissions (Route B)
FAX_SENDER_NAME="Taxpayer Services Office"
FAX_SENDER_COMPANY="Independent Petitioner"
FAX_SENDER_EMAIL="your-email@gmail.com"
FAX_SENDER_PHONE="2025550199"          # 10-digit US format phone for callback/header
FAX_STATION_ID="+18005550199"          # Caller ID / Local Station ID for T.30 header

# --- Gmail IMAP Credentials (Required for Route B Auto-Activation) ---
# Use a Gmail App Password (16 characters, generate via myaccount.google.com -> Security -> App Passwords)
GMAIL_IMAP_SERVER="imap.gmail.com"
GMAIL_IMAP_PORT=993
GMAIL_USERNAME="your-email@gmail.com"
GMAIL_APP_PASSWORD="xxxx xxxx xxxx xxxx"
GMAIL_POLL_TIMEOUT_SEC=120             # Max seconds to wait for activation email
GMAIL_POLL_INTERVAL_SEC=3              # Polling interval in seconds

# --- Route A (VoIP / 8YY SIP) Configuration ---
# Open US Toll-Free termination SIP servers (no auth / reverse-billed)
SIP_PRIMARY_8YY_TRUNK="tf.alcazarnetworks.com"
SIP_FALLBACK_8YY_TRUNK="tollfree.sip-trunk.info"
SIP_PORT=5060

# Asterisk Server / AMI Connection
ASTERISK_HOST="localhost"
ASTERISK_AMI_PORT=5038
ASTERISK_AMI_USER="faxadmin"
ASTERISK_AMI_SECRET="FaxAdminPass2026!"
ASTERISK_SPOOL_DIR="/var/spool/asterisk"
ASTERISK_FAX_SPOOL="/tmp/fax_spool"

# --- Route B (Web Gateway) Configuration ---
WEB_GATEWAY_HEADLESS=true              # Run Playwright in headless mode
WEB_GATEWAY_TIMEOUT_SEC=60             # Page load / submission timeout
WEB_GATEWAY_SCREENSHOT_DIR="./scratch" # Saved screenshots on error

# Optional US Proxy for Route B (Leave empty if running through US VPN / EC2)
# Format: http://user:pass@us-proxy.example.com:8080
HTTP_PROXY=""

# --- Logging & General ---
LOG_LEVEL="INFO"                       # DEBUG, INFO, WARNING, ERROR
DRY_RUN_DEFAULT=false                  # If true, all CLI commands run in dry-run mode

# --- AWS EC2 Ephemeral Remote Dispatcher Configuration ---
AWS_REGION="us-east-2"
AWS_INSTANCE_ID="i-0123456789abcdef0"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
SSH_KEY_PATH="~/.ssh/fax-key.pem"
SSH_USER="ec2-user"
